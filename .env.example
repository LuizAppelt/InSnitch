# InstaTracker - Environment Configuration Template
# Copie este arquivo para .env e preencha suas chaves se desejar

# Google Gemini API Key (Opcional - Usado para os relatórios com IA)
GEMINI_API_KEY=

# Cookie de Sessão do Instagram (Opcional - Pode ser informado via painel ou utilizar a extensão)
INSTAGRAM_SESSION_COOKIE=

# Modo padrão: True para simulação/demo ou False para real
MOCK_MODE_DEFAULT=False
